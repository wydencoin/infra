# Configuracoes da Stack de Monitoramento (copie para .env e preencha)
REMOTE_HOST=<HOST_OU_IP_DA_VM_RPC>
REMOTE_USER=ubuntu

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<SENHA_FORTE_DO_GRAFANA>
GRAFANA_ROOT_URL=http://localhost:3000

# Opcional: IPs privados/VPN dos validadores QBFT para scraping do Prometheus na porta 9545
VALIDATOR_1_IP=
VALIDATOR_2_IP=
VALIDATOR_3_IP=
