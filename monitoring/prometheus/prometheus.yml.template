global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  # 1. No Hyperledger Besu RPC (Loopback na VM RPC)
  - job_name: "besu-rpc"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["127.0.0.1:9545"]
        labels:
          instance: "vm4-rpc"
          role: "rpc-gateway"
          cluster: "wydencoin-qbft"

  # 2. Nos Validadores QBFT (preenchido via .env pelo deploy-monitoring.sh)
  # __VALIDATORS_BLOCK__

  # 3. Gateway API (Node.js na porta 8546)
  - job_name: "gateway-api"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["127.0.0.1:8546"]
        labels:
          instance: "vm4-gateway"
          app: "wydencoin-gateway"

  # 4. Metricas do Sistema Operacional (Node Exporter)
  - job_name: "node-exporter"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels:
          instance: "vm4-host"
